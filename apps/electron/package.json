{
  "name": "@harness/electron",
  "version": "0.1.0",
  "description": "Mint AI Chat & Agent - Electron Desktop App",
  "main": "dist/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite dev",
    "dev:electron": "pnpm build:main && pnpm build:preload && pnpm build:resources && sleep 2 && concurrently -k -n main,preload,app -c yellow,magenta,cyan \"pnpm watch:main\" \"pnpm watch:preload\" \"electronmon .\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:@anthropic-ai/claude-agent-sdk",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "watch:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:@anthropic-ai/claude-agent-sdk --watch=forever",
    "watch:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --watch=forever",
    "build:renderer": "vite build",
    "build:resources": "cp -r resources dist/ 2>/dev/null || true",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer && pnpm build:resources",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@radix-ui/react-slot": "^1.2.4",
    "@tiptap/core": "^3.23.2",
    "@tiptap/extension-mention": "^3.23.2",
    "@tiptap/extension-placeholder": "^3.23.2",
    "@tiptap/pm": "^3.23.2",
    "@tiptap/react": "^3.23.2",
    "@tiptap/starter-kit": "^3.23.2",
    "@tiptap/suggestion": "^3.23.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.469.0",
    "react-markdown": "^10.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.1",
    "zlib": "^1.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.24.0",
    "jotai": "^2.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "electronmon": {
    "patterns": [
      "dist/main.cjs",
      "dist/preload.cjs"
    ],
    "logLevel": "verbose"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
