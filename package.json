{
  "name": "harness-project",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-first project scaffold built on the Harness methodology",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "pnpm -r run build",
    "build:all": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "lint:arch": "pnpm --filter @harness/linting run check",
    "quality": "pnpm --filter @harness/tools run quality",
    "scaffold": "pnpm --filter @harness/tools run scaffold",
    "doc:garden": "pnpm --filter @harness/tools run doc-garden"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0"
  }
}
